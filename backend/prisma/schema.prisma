generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TournamentClaimStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum UserRole {
  PLAYER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  rulesAcceptedAt DateTime?
  rulesVersion    String?
  password  String
  role      UserRole @default(PLAYER)
  createdAt DateTime @default(now())

  predictions  Prediction[]
  payments     Payment[]
  participants TournamentParticipant[]
  passwordResetTokens PasswordResetToken[]
  tournamentClaims TournamentClaim[]
  resultCorrections TournamentResultCorrection[]
}

model League {
  id          Int      @id
  name        String
  type        String
  country     String
  countryCode String?
  logo        String?
  season      Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teams       Team[]
  matchdays   Matchday[]
  matches     Match[]
  tournaments Tournament[]
}

model Tournament {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  leagueId Int
  league   League @relation(fields: [leagueId], references: [id])

  season Int

  inscription Float
  currency    String @default("COP")
  prize       Float
  maxPlayers  Int

  registrationStartsAt DateTime
  registrationEndsAt   DateTime

  startsAt          DateTime
  endsAt            DateTime
  predictionsCloseAt DateTime?
  tournamentMatches TournamentMatch[]

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  participants TournamentParticipant[]
  predictions  Prediction[]
  payments     Payment[]
  prizeClosure TournamentPrizeClosure?
  resultsPublishedAt DateTime?
  claims TournamentClaim[]
  resultsRevisedAt DateTime?
}

model TournamentParticipant {
  id Int @id @default(autoincrement())

  tournamentId Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  joinedAt DateTime @default(now())
  paid     Boolean  @default(false)

  payments Payment[]

  @@unique([tournamentId, userId])
  predictionsSubmittedAt DateTime?
}

model Team {
  id        Int      @id
  name      String
  shortName String
  logo      String
  leagueId  Int
  league    League   @relation(fields: [leagueId], references: [id])
  createdAt DateTime @default(now())

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
}

model Matchday {
  id Int @id @default(autoincrement())

  leagueId Int
  league   League @relation(fields: [leagueId], references: [id])

  season     Int
  tournament String
  roundName  String
  number     Int?

  startDate DateTime
  endDate   DateTime

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  matches Match[]

  @@unique([leagueId, season, tournament, roundName])
}

model Match {
  id    Int @id @default(autoincrement())
  apiId Int @unique

  date      DateTime
  homeScore Int?
  awayScore Int?
  finished  Boolean   @default(false)
  scoredAt  DateTime?

  createdAt DateTime @default(now())

  homeTeamId Int
  awayTeamId Int
  matchdayId Int
  leagueId   Int

  tournamentMatches TournamentMatch[]

  homeTeam Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  matchday Matchday @relation(fields: [matchdayId], references: [id])
  league   League   @relation(fields: [leagueId], references: [id])

  predictions Prediction[]

  @@index([matchdayId])
  @@index([leagueId])
  @@index([date])
  resultCorrections TournamentResultCorrection[]
}

model Prediction {
  id        Int      @id @default(autoincrement())
  homeScore Int
  awayScore Int
  points    Int      @default(0)
  createdAt DateTime @default(now())

  userId       Int
  matchId      Int
  tournamentId Int

  user       User       @relation(fields: [userId], references: [id])
  match      Match      @relation(fields: [matchId], references: [id])
  tournament Tournament @relation(fields: [tournamentId], references: [id])

  @@unique([userId, matchId, tournamentId])
  @@index([userId])
  @@index([matchId])
  @@index([tournamentId])
}

model Payment {
  id        Int       @id @default(autoincrement())
  amount    Float
  currency  String @default("COP")
  reference String
  status    String
  method    String?
  createdAt DateTime  @default(now())
  paidAt    DateTime?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  tournamentId Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  participantId Int?
  participant   TournamentParticipant? @relation(fields: [participantId], references: [id])

  @@index([userId])
  @@index([tournamentId])
  @@index([participantId])
}

model Prize {
  id        Int      @id @default(autoincrement())
  title     String
  amount    Float
  createdAt DateTime @default(now())
}

model TournamentMatch {
  id           Int      @id @default(autoincrement())
  tournamentId Int
  matchId      Int
  position     Int
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  match      Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, matchId])
  @@unique([tournamentId, position])
  @@index([tournamentId])
  @@index([matchId])
}


// Cierre económico y deportivo definitivo de una Polla.
// Los importes se almacenan como pesos colombianos enteros.
model TournamentPrizeClosure {
  id Int @id @default(autoincrement())

  tournamentId Int @unique
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)

  currency String @default("COP")

  paidPlayers Int

  revenueCOP   Int
  prizePoolCOP Int
  profitCOP    Int

  firstCOP  Int
  secondCOP Int
  thirdCOP  Int

  // Ganadores con ID, puntos, posición y premio individual.
  winners Json

  allocatedCOP     Int
  undistributedCOP Int

  rulesVersion String @default("1.0")
  closedAt     DateTime @default(now())
}


model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model TournamentClaim {
  id Int @id @default(autoincrement())

  tournamentId Int
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)

  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  reason String
  status TournamentClaimStatus @default(PENDING)

  decision String?
  createdAt DateTime @default(now())
  resolvedAt DateTime?

  @@index([tournamentId, status])
  @@index([userId])
  @@index([createdAt])
  resultCorrection TournamentResultCorrection?
}


// Auditoría de correcciones oficiales.
// Una corrección requiere una reclamación aceptada.
// La aplicación y el registro deben realizarse
// dentro de la misma transacción.
model TournamentResultCorrection {
  id Int @id @default(autoincrement())

  claimId Int @unique
  claim TournamentClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)

  matchId Int
  match Match @relation(fields: [matchId], references: [id], onDelete: Restrict)

  adminId Int
  admin User @relation(fields: [adminId], references: [id], onDelete: Restrict)

  oldHomeScore Int
  oldAwayScore Int

  newHomeScore Int
  newAwayScore Int

  reason String

  appliedAt DateTime @default(now())

  @@index([matchId])
  @@index([adminId])
  @@index([appliedAt])
}
