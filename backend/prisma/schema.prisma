generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  predictions Prediction[]
  payments    Payment[]
}

model League {
  @@unique([id, season])
  id          Int      @id
  name        String
  type        String
  country     String
  countryCode String?
  logo        String?
  season      Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teams     Team[]
  matchdays Matchday[]
  matches   Match[]
}

model Team {
  id        Int      @id
  name      String
  shortName String
  logo      String
  leagueId  Int
  league    League   @relation(fields: [leagueId], references: [id])
  createdAt DateTime @default(now())

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
}

model Matchday {
  id         Int      @id @default(autoincrement())
  leagueId   Int
  league     League   @relation(fields: [leagueId], references: [id])
  number     Int
  tournament String
  season     Int
  startDate  DateTime
  endDate    DateTime
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  matches Match[]
}

model Match {
  id          Int      @id @default(autoincrement())
  apiId       Int      @unique

  date        DateTime
  homeScore   Int?
  awayScore   Int?
  finished    Boolean  @default(false)

  createdAt   DateTime @default(now())

  homeTeamId  Int
  awayTeamId  Int
  matchdayId  Int
  leagueId    Int

  homeTeam    Team      @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam    Team      @relation("AwayTeam", fields: [awayTeamId], references: [id])
  matchday    Matchday  @relation(fields: [matchdayId], references: [id])
  league      League    @relation(fields: [leagueId], references: [id])

  predictions Prediction[]
}

model Prediction {
  id        Int      @id @default(autoincrement())
  homeScore Int
  awayScore Int
  points    Int      @default(0)
  createdAt DateTime @default(now())
  userId    Int
  matchId   Int

  user  User  @relation(fields: [userId], references: [id])
  match Match @relation(fields: [matchId], references: [id])

  @@unique([userId, matchId])
}

model Payment {
  id        Int      @id @default(autoincrement())
  amount    Float
  reference String
  status    String
  createdAt DateTime @default(now())
  userId    Int

  user User @relation(fields: [userId], references: [id])
}

model Prize {
  id        Int      @id @default(autoincrement())
  title     String
  amount    Float
  createdAt DateTime @default(now())
}