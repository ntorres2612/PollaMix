# GOLPRO - PLANTILLA DE ENTORNOS
# No colocar secretos reales en este archivo.
# Copiar posteriormente a deploy/.env en el VPS.
# Ese archivo debe tener permisos 600 y no subirse a Git.

# ===== POSTGRESQL PRD =====
PRD_DB_PASSWORD=CAMBIAR_CLAVE_PRD

# ===== POSTGRESQL QA =====
QA_DB_PASSWORD=CAMBIAR_CLAVE_QA

# ===== CONEXIONES =====
# Los passwords incluidos en las URL deben coincidir
# con los configurados arriba y codificarse como URL.

PRD_DATABASE_URL=postgresql://golpro_prd_user:CAMBIAR_CLAVE_PRD@postgres-prd:5432/golpro_prd?schema=public

QA_DATABASE_URL=postgresql://golpro_qa_user:CAMBIAR_CLAVE_QA@postgres-qa:5432/golpro_qa?schema=public

# ===== AUTENTICACIÓN =====
PRD_JWT_SECRET=CAMBIAR_SECRET_PRD
QA_JWT_SECRET=CAMBIAR_SECRET_QA

# ===== DOMINIOS =====
# Un dominio para producción y el subdominio qa. Los dos apuntan a la IP de la VPS.
# PRD_API_URL es la misma web con /api. Caddy quita ese prefijo antes de llegar al backend.

PRD_DOMAIN=totalgol.tech
QA_DOMAIN=qa.totalgol.tech

PRD_FRONTEND_URL=https://totalgol.tech
PRD_API_URL=https://totalgol.tech/api

QA_FRONTEND_URL=https://qa.totalgol.tech
QA_API_URL=https://qa.totalgol.tech/api

# ===== API DE FÚTBOL =====
# La clave se compra en api-football y solo vive en este archivo del VPS.
FOOTBALL_API_KEY=CAMBIAR_CLAVE_API_FUTBOL

# ===== GMAIL DE ABONOS =====
# Cliente web de Google. En URIs de redirección hay que registrar las dos direcciones de abajo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_WHATSAPP_NUMBER=CAMBIAR_WHATSAPP
PRD_GOOGLE_REDIRECT_URI=https://totalgol.tech/api/payments/mailbox/callback
QA_GOOGLE_REDIRECT_URI=https://qa.totalgol.tech/api/payments/mailbox/callback

# ===== HOSTINGER EMAIL =====
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contacto@totalgol.tech
SMTP_PASSWORD=CAMBIAR_CLAVE_SMTP
SMTP_FROM=contacto@totalgol.tech
