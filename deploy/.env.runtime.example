# GOLPRO - PLANTILLA DE ENTORNOS
# No colocar secretos reales en este archivo.
# Copiar posteriormente a deploy/.env en el VPS.
# Ese archivo debe tener permisos 600 y no subirse a Git.

# ===== POSTGRESQL PRD =====
PRD_DB_PASSWORD=CAMBIAR_CLAVE_PRD

# ===== POSTGRESQL QA =====
QA_DB_PASSWORD=CAMBIAR_CLAVE_QA

# ===== CONEXIONES =====
# Los passwords incluidos en las URL deben coincidir
# con los configurados arriba y codificarse como URL.

PRD_DATABASE_URL=postgresql://golpro_prd_user:CAMBIAR_CLAVE_PRD@postgres-prd:5432/golpro_prd?schema=public

QA_DATABASE_URL=postgresql://golpro_qa_user:CAMBIAR_CLAVE_QA@postgres-qa:5432/golpro_qa?schema=public

# ===== AUTENTICACIÓN =====
PRD_JWT_SECRET=CAMBIAR_SECRET_PRD
QA_JWT_SECRET=CAMBIAR_SECRET_QA

# ===== DOMINIOS =====
# Reemplazar con dominios definitivos.

PRD_FRONTEND_URL=https://DOMINIO_PRD
PRD_API_URL=https://API_DOMINIO_PRD

QA_FRONTEND_URL=https://DOMINIO_QA
QA_API_URL=https://API_DOMINIO_QA

# ===== HOSTINGER EMAIL =====
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=gerencia@torrestech.com.co
SMTP_PASSWORD=CAMBIAR_CLAVE_SMTP
SMTP_FROM=gerencia@torrestech.com.co

# Dominio público, sin https://
PRD_DOMAIN=DOMINIO_GOLPRO
